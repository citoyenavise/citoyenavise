# Staging Environment Configuration
# Used for docker-compose local staging and pre-production testing

# Application
NODE_ENV=staging
PORT=5000

# Database
DATABASE_URL=postgresql://staging_user:staging_password@postgres:5432/citoyenavise_staging
DB_HOST=postgres
DB_PORT=5432
DB_USER=staging_user
DB_PASSWORD=staging_password
DB_NAME=citoyenavise_staging

# Authentication
JWT_SECRET=staging_secret_key_change_in_production_12345678901234567890
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# Email Service (Brevo/Sendinblue)
MAIL_SERVICE=brevo
BREVO_API_KEY=your_brevo_staging_api_key_here
MAIL_FROM=staging@citoyenavise.org
MAIL_FROM_NAME=Citoyen Avisé Staging

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_CACHE=true

# External Services (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# Snyk (optional for staging)
SNYK_TOKEN=

# SonarQube (optional for staging)
SONARQUBE_HOST_URL=
SONARQUBE_TOKEN=
