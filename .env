# Configuration pour développement Docker
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=citoyenavise_dev
DB_PORT=5432

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_PORT=6379

# JWT Secret (généré: openssl rand -base64 32)
JWT_SECRET=development_secret_key_min_32_chars_change_in_prod_abc123def456
JWT_EXPIRY_ACCESS=24h
JWT_EXPIRY_REFRESH=7d

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost,http://127.0.0.1:3000

# Logging
LOG_LEVEL=debug

# Admin Panel (pgAdmin)
PGADMIN_EMAIL=admin@citoyenavise.local
PGADMIN_PASSWORD=admin

# Optional services
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
