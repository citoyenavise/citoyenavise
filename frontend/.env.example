# API Configuration
# Options:
# - Absolute URL: http://localhost:5000/api/v1 (development/fixed domain)
# - Relative URL: /api/v1 (production with backend on same domain)
# - Docker: http://backend:5000/api/v1 (container-to-container)
# Fallback (if not set): /api/v1
VITE_API_URL=/api/v1

# App Name
VITE_APP_NAME=Citoyen Avisé

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=
