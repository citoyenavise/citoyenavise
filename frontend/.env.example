# API Configuration
# Development LOCAL:
#   VITE_API_URL=/api
#   (Vite proxy rewrites /api/* to http://localhost:3000/api/v1/*)
#
# Production:
#   VITE_API_URL=http://api.citoyenavise.org/api/v1
#   (absolute URL to production API)
#
# Docker/Staging:
#   VITE_API_URL=http://backend:3000/api/v1
#   (backend service URL in docker-compose)
#
# See frontend/vite.config.js for proxy configuration
VITE_API_URL=/api

# App Name
VITE_APP_NAME=Citoyen Avisé

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=
