# API Configuration
# DEV LOCAL: Use relative URL (Vite proxy handles routing)
# - Relative URL: /api/v1 (recommended - proxy to localhost:3000)
#
# Other options:
# - Absolute: http://localhost:3000/api/v1 (direct, may have CORS issues)
# - Docker: http://backend:3000/api/v1 (container-to-container)
#
# See frontend/vite.config.js for proxy configuration
# Fallback (if not set): /api/v1
VITE_API_URL=/api/v1

# App Name
VITE_APP_NAME=Citoyen Avisé

# Sentry Error Tracking (optional)
# Get your DSN from: https://sentry.io
VITE_SENTRY_DSN=
