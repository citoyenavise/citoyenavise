################################
# 🔧 CONFIGURATION BACKEND — Citoyen Avisé
# Copier ce fichier en .env et configurer
################################

# 🗄️  DATABASE (PostgreSQL + PostGIS)
# =======================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/citoyenavise_dev

# 🔐 AUTHENTICATION (Magic Link + JWT)
# =======================================
# Générer: openssl rand -hex 32
JWT_SECRET=your-super-secret-key-min-32-characters-CHANGE-IN-PRODUCTION

# 🚀 SERVER
# =======================================
NODE_ENV=development
PORT=5000
API_VERSION=1.0.0
SERVICE_NAME=citoyenavise-backend

# 🌐 CORS
# =======================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173

# 📧 EMAIL (Magic Link par SMTP)
# =======================================
# Gmail : smtp.gmail.com:587 (utiliser app password, pas votre password)
# SendGrid : smtp.sendgrid.net:587
# Brevo : smtp-relay.brevo.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-NOT-your-password
SMTP_FROM=noreply@citoyenavise.org
FRONTEND_URL=http://localhost:5173

# 💾 REDIS (Cache, optionnel)
# =======================================
# Si vide = cache désactivé
REDIS_URL=redis://localhost:6379

# 📊 LOGGING
# =======================================
LOG_LEVEL=debug

# 📌 SENTRY (Error tracking, optionnel)
# =======================================
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

################################
# ⚠️  SETUP GUIDE
# =======================================

# 1. DATABASE
# $ createdb citoyenavise_dev
# $ psql citoyenavise_dev -c "CREATE EXTENSION postgis;"
# Note: Sequelize gère les migrations automatiquement (npm run dev)

# 2. EMAIL (Gmail)
# a) Enable 2-Factor Authentication
# b) Create App Password at https://myaccount.google.com/apppasswords
# c) Copy app password to SMTP_PASSWORD

# 3. SERVER
# $ npm install
# $ npm run dev

# 4. TEST
# $ curl http://localhost:5000/api/v1/health
