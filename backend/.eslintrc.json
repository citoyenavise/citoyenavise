{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["airbnb-base"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "error",
    "prefer-const": "error",
    "arrow-body-style": "warn",
    "consistent-return": "warn",
    "import/extensions": ["error", "ignorePackages"],
    "import/prefer-default-export": "off",
    "no-param-reassign": "warn",
    "no-use-before-define": "warn",
    "func-names": "off"
  }
}
