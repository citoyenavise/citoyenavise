{
  "name": "content",
  "version": "1.0.0",
  "description": "Content management and curation",
  "dependencies": [],
  "capabilities": [
    "content:create",
    "content:publish",
    "content:manage"
  ],
  "events": [
    "content:published",
    "content:updated",
    "content:archived"
  ],
  "routes": {
    "prefix": "/api/v1/content",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}