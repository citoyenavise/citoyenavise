{
  "name": "admin",
  "version": "1.0.0",
  "description": "Administrative functions, audit logging, permissions management",
  "dependencies": [],
  "capabilities": ["admin:read", "admin:write", "admin:audit", "admin:permissions"],
  "events": ["admin:action_logged", "admin:permission_changed", "admin:audit_event"],
  "routes": {
    "prefix": "/api/v1/admin",
    "methods": ["GET", "POST", "PUT", "DELETE"]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}
