{
  "name": "influence_system",
  "version": "1.0.0",
  "description": "User influence tracking and rewards",
  "dependencies": [],
  "capabilities": [
    "influence:view",
    "influence:track"
  ],
  "events": [
    "influence:changed",
    "influence:awarded"
  ],
  "routes": {
    "prefix": "/api/v1/influence_system",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}