{
  "name": "popular_system",
  "version": "1.0.0",
  "description": "Popular content ranking system",
  "dependencies": [],
  "capabilities": [
    "popular:view",
    "popular:rank"
  ],
  "events": [
    "popular:ranked",
    "popular:updated"
  ],
  "routes": {
    "prefix": "/api/v1/popular_system",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}