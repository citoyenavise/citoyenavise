{
  "name": "moderation",
  "version": "1.0.0",
  "description": "Content moderation and flagging",
  "dependencies": [],
  "capabilities": [
    "moderation:view",
    "moderation:review",
    "moderation:action"
  ],
  "events": [
    "content:flagged",
    "content:reviewed",
    "content:moderated"
  ],
  "routes": {
    "prefix": "/api/v1/moderation",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}