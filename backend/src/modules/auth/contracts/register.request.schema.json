{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Register Request",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "description": "User password (min 8 chars, 1 uppercase required)"
    },
    "username": {
      "type": "string",
      "minLength": 3,
      "maxLength": 50,
      "description": "Username"
    }
  },
  "required": ["email", "password", "username"],
  "additionalProperties": false
}
