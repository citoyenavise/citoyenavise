{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Login Request",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "description": "User password"
    }
  },
  "required": ["email", "password"],
  "additionalProperties": false
}
