{
  "name": "auth",
  "version": "1.0.0",
  "description": "Authentication and JWT session management",
  "dependencies": [],
  "capabilities": ["auth:register", "auth:login", "auth:logout", "auth:refresh"],
  "events": ["user:registered", "user:logged_in", "user:logged_out", "token:refreshed"],
  "routes": {
    "prefix": "/api/v1/auth",
    "methods": ["POST", "GET"]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}
