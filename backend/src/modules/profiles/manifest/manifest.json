{
  "name": "profiles",
  "version": "1.0.0",
  "description": "User profile management",
  "dependencies": [],
  "capabilities": [
    "profile:view",
    "profile:edit",
    "profile:manage"
  ],
  "events": [
    "profile:created",
    "profile:updated",
    "profile:deleted"
  ],
  "routes": {
    "prefix": "/api/v1/profiles",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}