{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Send Notification Request",
  "type": "object",
  "properties": {
    "userId": { "type": "string" },
    "title": { "type": "string" },
    "message": { "type": "string" },
    "type": { "type": "string", "enum": ["info", "warning", "success", "error"] }
  },
  "required": ["userId", "title", "message"],
  "additionalProperties": false
}
