{
  "name": "cms",
  "version": "1.0.0",
  "description": "Content management system",
  "dependencies": [],
  "capabilities": [
    "cms:manage",
    "cms:publish"
  ],
  "events": [
    "cms:published",
    "cms:updated"
  ],
  "routes": {
    "prefix": "/api/v1/cms",
    "methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE"
    ]
  },
  "lifecycle": {
    "initRequired": true,
    "readyRequired": true,
    "healthChecks": true
  }
}