{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recovery Engine - Read-Only Specification",
  "version": "1.0.0",
  "sealed": true,
  "immutable": true,
  "read_only": true,
  "execution_allowed": false,

  "description": "Read-only specification for recovery engine. Actual implementation in Phase 1.2.",

  "recovery_engine_specification": {
    "purpose": "Automatic recovery from failures while maintaining system integrity",
    "recovery_triggers": [
      "Module initialization failure",
      "Service injection failure",
      "State transition failure",
      "Event processing failure",
      "Invariant violation"
    ]
  },

  "recovery_levels": [
    {
      "level": 1,
      "name": "Automatic Service Recovery",
      "scope": "Single module/service",
      "action": "Restart service",
      "max_retries": 3,
      "escalation": "If retry fails"
    },
    {
      "level": 2,
      "name": "Module Reinitialization",
      "scope": "Module and dependents",
      "action": "Reinitialize module",
      "max_retries": 2,
      "escalation": "If reinitialization fails"
    },
    {
      "level": 3,
      "name": "Cascading Dependency Recovery",
      "scope": "Module chain",
      "action": "Reinitialize dependencies",
      "max_retries": 1,
      "escalation": "If cascading recovery fails"
    },
    {
      "level": 4,
      "name": "System Restart",
      "scope": "Entire system",
      "action": "Graceful shutdown and restart",
      "max_retries": 0,
      "escalation": "Manual intervention required"
    }
  ],

  "recovery_policies": [
    {
      "failure_type": "Module initialization failure",
      "recovery_level": 2,
      "timeout_sec": 60,
      "action": "Reinitialize module and dependents"
    },
    {
      "failure_type": "Service injection failure",
      "recovery_level": 1,
      "timeout_sec": 30,
      "action": "Restart service"
    },
    {
      "failure_type": "State transition failure",
      "recovery_level": 3,
      "timeout_sec": 30,
      "action": "Revert to previous state"
    },
    {
      "failure_type": "Invariant violation",
      "recovery_level": 4,
      "timeout_sec": 0,
      "action": "System restart"
    }
  ],

  "fallback_mechanisms": {
    "module_fallback": "Use cached or previous state",
    "service_fallback": "Degrade gracefully or fail fast",
    "event_fallback": "Queue event for later retry",
    "state_fallback": "Return to previous valid state"
  },

  "automatic_remediation": {
    "cache_invalidation": "Clear affected cache entries",
    "retry_with_backoff": "Exponential backoff retry strategy",
    "circuit_breaker": "Prevent cascading failures",
    "graceful_degradation": "Continue with reduced functionality"
  },

  "manual_intervention_triggers": [
    "System restart required",
    "Level 4 recovery triggered",
    "Multiple recovery attempts failed",
    "Critical invariant violation"
  ],

  "implementation_note": "This is a pure specification file. Actual recovery engine will be implemented in Phase 1.2 based on this specification."
}
