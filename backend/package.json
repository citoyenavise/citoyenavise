{
  "name": "citoyenavise-backend",
  "version": "1.0.0",
  "description": "Backend API pour la plateforme Citoyen Avisé",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:lint": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/lint.test.js --verbose",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/ci.test.js --verbose",
    "test:e2e": "playwright test __tests__/e2e.test.js",
    "test:all": "npm run test && npm run test:ci && npm run test:e2e",
    "lint": "eslint src/ __tests__/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"__tests__/**/*.js\"",
    "security:check": "npm audit --audit-level=moderate",
    "migrate": "node scripts/migrate.js",
    "db:check-tables": "node scripts/check-tables.js",
    "seed": "node seeders/seed.js",
    "seed:gamification": "node scripts/seed-gamification.js",
    "promote:admin": "node scripts/promote-admin.js"
  },
  "keywords": [
    "civic",
    "democracy",
    "api"
  ],
  "author": "Citoyen Avisé",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^6.9.1",
    "pg": "^8.8.0",
    "sequelize": "^6.32.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^14.0.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "eslint": "^8.40.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^3.0.0",
    "supertest": "^6.3.3"
  }
}
