{
  "name": "citoyenavise-backend",
  "version": "1.0.0",
  "description": "Backend API pour plateforme civique Citoyen Avisé",
  "main": "server.js",
  "scripts": {
    "setup": "node setup.js",
    "setup:db": "node setup.js db",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "build": "npm run lint && npm run test",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "migrate": "node -e \"require('./src/database/migrationRunner.js').runPendingMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "migrate:status": "node -e \"require('./src/database/migrationRunner.js').showStatus().then(() => process.exit(0))\"",
    "db:migrate": "node src/database/migrate.js",
    "db:rollback": "node src/database/rollback.js",
    "db:seed": "node src/database/seed.js",
    "db:reset": "node src/database/reset.js"
  },
  "keywords": ["civic", "democracy", "canada"],
  "author": "Citoyen Avisé",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.1.5",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "redis": "^4.6.10",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8",
    "compression": "^1.7.4",
    "ws": "^8.14.2",
    "multer": "^1.4.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "@sentry/node": "^7.80.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
