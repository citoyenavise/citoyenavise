{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dependency Graph",
  "description": "Static declaration of module dependencies (DAG - Directed Acyclic Graph)",
  "version": "1.0.0",
  "phase": "1.5",
  "sealed": true,
  "immutable": true,
  "read_only": true,
  "lastUpdated": "2026-05-07",
  "governance_level": "CONSTITUTIONAL",

  "graphStructure": "DAG",
  "cycleDetection": "REQUIRED",
  "cycles": [],
  "isCyclic": false,

  "levels": {
    "0": {
      "name": "INFRASTRUCTURE",
      "modules": [
        "logger",
        "cache",
        "eventBus"
      ],
      "dependencies": [],
      "canDependOnLevels": []
    },

    "0b": {
      "name": "INFRASTRUCTURE_CORE",
      "modules": [
        "database"
      ],
      "dependencies": [
        {
          "module": "logger",
          "reason": "Error logging"
        }
      ],
      "canDependOnLevels": [0]
    },

    "1": {
      "name": "DOMAIN_CORE",
      "modules": [
        "auth"
      ],
      "dependencies": [
        {
          "module": "database",
          "reason": "User credential storage"
        },
        {
          "module": "logger",
          "reason": "Audit logging"
        },
        {
          "module": "eventBus",
          "reason": "Publish auth events"
        }
      ],
      "canDependOnLevels": [0, "0b"]
    },

    "2": {
      "name": "DOMAIN",
      "modules": [
        "users",
        "posts"
      ],
      "dependencies": {
        "users": [
          {
            "module": "database",
            "reason": "User data persistence"
          },
          {
            "module": "auth",
            "reason": "Permission checks"
          },
          {
            "module": "eventBus",
            "reason": "Emit user events"
          }
        ],
        "posts": [
          {
            "module": "database",
            "reason": "Post data persistence"
          },
          {
            "module": "users",
            "reason": "Author reference"
          },
          {
            "module": "auth",
            "reason": "Permission checks"
          },
          {
            "module": "eventBus",
            "reason": "Emit post events"
          }
        ]
      },
      "canDependOnLevels": [0, "0b", 1]
    },

    "3": {
      "name": "DERIVED",
      "modules": [
        "search",
        "analytics",
        "notifications"
      ],
      "dependencies": {
        "search": [
          {
            "module": "posts",
            "reason": "Index posts"
          },
          {
            "module": "users",
            "reason": "Index users"
          },
          {
            "module": "database",
            "reason": "Query indexed data"
          },
          {
            "module": "eventBus",
            "reason": "Listen to index events"
          }
        ],
        "analytics": [
          {
            "module": "eventBus",
            "reason": "Listen to all events"
          },
          {
            "module": "database",
            "reason": "Store metrics"
          }
        ],
        "notifications": [
          {
            "module": "users",
            "reason": "Notification delivery"
          },
          {
            "module": "posts",
            "reason": "Post events"
          },
          {
            "module": "auth",
            "reason": "Permission checks"
          },
          {
            "module": "eventBus",
            "reason": "Listen to events"
          }
        ]
      },
      "canDependOnLevels": [0, "0b", 1, 2]
    },

    "4": {
      "name": "GOVERNANCE",
      "modules": [
        "governance"
      ],
      "dependencies": [
        {
          "module": "database",
          "reason": "Audit trail storage"
        },
        {
          "module": "logger",
          "reason": "Governance logging"
        },
        {
          "module": "eventBus",
          "reason": "Listen to all events"
        }
      ],
      "canDependOnLevels": [0, "0b", 1, 2, 3],
      "note": "Governance observes all but does not depend on domain logic"
    }
  },

  "interdictions": [
    {
      "id": "RULE_NO_REVERSE_DEPENDENCY",
      "description": "Higher level modules MUST NOT depend on lower level modules",
      "enforcement": "MANDATORY"
    },
    {
      "id": "RULE_NO_CYCLES",
      "description": "Graph MUST be acyclic (DAG)",
      "enforcement": "MANDATORY"
    },
    {
      "id": "RULE_LEVEL_BOUNDARY",
      "description": "Each module can only depend on declared canDependOnLevels",
      "enforcement": "MANDATORY"
    },
    {
      "id": "RULE_SINGLE_ROOT",
      "description": "INFRASTRUCTURE (level 0) must have no dependencies",
      "enforcement": "MANDATORY"
    }
  ],

  "cyclicityAnalysis": {
    "totalModules": 11,
    "totalDependencies": 22,
    "hasNoCycles": true,
    "longestPath": ["logger", "database", "auth", "posts", "search"],
    "longestPathLength": 5
  },

  "moduleDependencyMatrix": {
    "logger": {
      "dependsOn": [],
      "dependedByCount": 3
    },
    "database": {
      "dependsOn": ["logger"],
      "dependedByCount": 7
    },
    "eventBus": {
      "dependsOn": [],
      "dependedByCount": 8
    },
    "cache": {
      "dependsOn": [],
      "dependedByCount": 0
    },
    "auth": {
      "dependsOn": ["database", "logger", "eventBus"],
      "dependedByCount": 4
    },
    "users": {
      "dependsOn": ["database", "auth", "eventBus"],
      "dependedByCount": 3
    },
    "posts": {
      "dependsOn": ["database", "users", "auth", "eventBus"],
      "dependedByCount": 2
    },
    "search": {
      "dependsOn": ["posts", "users", "database", "eventBus"],
      "dependedByCount": 0
    },
    "analytics": {
      "dependsOn": ["eventBus", "database"],
      "dependedByCount": 0
    },
    "notifications": {
      "dependsOn": ["users", "posts", "auth", "eventBus"],
      "dependedByCount": 0
    },
    "governance": {
      "dependsOn": ["database", "logger", "eventBus"],
      "dependedByCount": 0
    }
  },

  "declarationComplete": true,
  "consistencyVerified": true
}
