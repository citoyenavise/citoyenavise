      "restrictionLevel": "ADMIN_ONLY",
      "requiresIdentity": true,
      "requiresApproval": true,
      "auditTrail": true
    }
  },

  "isolationLevels": {
    "0": {
      "name": "INFRASTRUCTURE",
      "description": "Core infrastructure, no restrictions",
      "modules": ["logger", "cache", "eventBus"],
      "accessControl": "NONE",
      "canAccess": "ALL_MODULES"
    },

    "0b": {
      "name": "INFRASTRUCTURE_CORE",
      "description": "Core database, role-based restrictions",
      "modules": ["database"],
      "accessControl": "ROLE_BASED",
      "canAccess": ["auth", "users", "posts", "search", "analytics", "notifications", "governance"]
    },

    "1": {
      "name": "DOMAIN_CORE",
      "description": "Core domain logic, authentication required",
      "modules": ["auth"],
      "accessControl": "AUTHENTICATED",
      "canAccess": ["users", "posts", "search", "notifications", "governance"]
    },

    "2": {
      "name": "DOMAIN",
      "description": "Domain entities, owner/admin restrictions",
      "modules": ["users", "posts"],
      "accessControl": "OWNER_OR_ADMIN",
      "canAccess": ["search", "analytics", "notifications", "governance"]
    },

    "3": {
      "name": "DERIVED",
      "description": "Derived services, read-only or role-based",
      "modules": ["search", "analytics", "notifications"],
      "accessControl": "AUTHENTICATED_OR_ROLE_BASED",
      "canAccess": ["governance"]
    },

    "4": {
      "name": "GOVERNANCE",
      "description": "Governance layer, admin-only",
      "modules": ["governance"],
      "accessControl": "ADMIN_ONLY",
      "canAccess": []
    }
  },

  "escalationRules": {
    "NONE": {
      "description": "No escalation required",
      "action": "ALLOW"
    },

    "PERMISSION_DENIED_ESCALATE": {
      "description": "Permission denied should be escalated to governance",
      "action": "ESCALATE_TO_GOVERNANCE",
      "severity": "HIGH"
    },

    "SCHEMA_MODIFY_REQUIRES_ADMIN": {
      "description": "Schema modifications require admin approval",
      "action": "REQUIRE_APPROVAL",
      "approver": "ADMIN_ONLY",
      "severity": "CRITICAL"
    },

    "USER_DELETE_REQUIRES_AUDIT": {
      "description": "User deletion requires audit trail verification",
      "action": "REQUIRE_AUDIT",
      "severity": "HIGH"
    },

    "POST_DELETE_REQUIRES_AUDIT": {
      "description": "Post deletion requires audit trail verification",
      "action": "REQUIRE_AUDIT",
      "severity": "MEDIUM"
    },

    "INDEX_REBUILD_REQUIRES_ADMIN": {
      "description": "Search index rebuild requires admin approval",
      "action": "REQUIRE_APPROVAL",
      "approver": "ADMIN_ONLY",
      "severity": "HIGH"
    },

    "REPORT_VIEW_REQUIRES_ROLE": {
      "description": "Analytics report view requires specific role",
      "action": "REQUIRE_ROLE",
      "severity": "MEDIUM"
    },

    "ENFORCE_REQUIRES_APPROVAL": {
      "description": "Governance enforcement requires admin approval",
      "action": "REQUIRE_APPROVAL",
      "approver": "ADMIN_ONLY",
      "severity": "CRITICAL"
    }
  },

  "accessViolationResponses": {
    "LOW": {
      "description": "Low severity violation (e.g., unauthorized READ)",
      "action": "LOG_AND_CONTINUE",
      "recovery": "NONE"
    },

    "MEDIUM": {
      "description": "Medium severity violation (e.g., unauthorized UPDATE)",
      "action": "LOG_AND_ALERT",
      "recovery": "RETRY_OR_FALLBACK"
    },

    "HIGH": {
      "description": "High severity violation (e.g., unauthorized DELETE, SCHEMA_MODIFY)",
      "action": "BLOCK_AND_ESCALATE",
      "recovery": "ESCALATE_ONLY"
    },

    "CRITICAL": {
      "description": "Critical severity violation (e.g., unauthorized ADMIN actions)",
      "action": "BLOCK_AND_SHUTDOWN",
      "recovery": "SYSTEM_HALT_OR_ROLLBACK"
    }
  },

  "defaultAccessDeniedBehavior": {
    "logViolation": true,
    "blockOperation": true,
    "emitEvent": "access_violation_blocked",
    "escalateToGovernance": true,
    "auditTrailRequired": true
  },

  "totalModules": 11,
  "totalCapabilities": 31,
  "totalIsolationLevels": 6,
  "totalEscalationRules": 7,
  "declarationComplete": true,
  "runtimeEnforcementNote": "These access rules are INTERPRETED by Phase 1.7 SecurityGuard at runtime. No logic here, purely declarative."
}
