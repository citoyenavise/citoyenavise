{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Versioning Policy - Semantic Versioning and Change Management",
  "version": "1.0.0",
  "sealed": true,
  "immutable": true,
  "read_only": true,

  "versioning_scheme": {
    "standard": "SEMANTIC_VERSIONING",
    "format": "MAJOR.MINOR.PATCH",
    "example": "1.2.3"
  },

  "version_semantics": {
    "MAJOR": {
      "description": "Incompatible API changes",
      "increment_when": "Breaking changes introduced",
      "examples": ["Remove service", "Change event schema", "Modify permission model"],
      "compatibility": "BREAKING",
      "migration_required": true
    },
    "MINOR": {
      "description": "Backward-compatible functionality additions",
      "increment_when": "New features without breaking changes",
      "examples": ["Add new event type", "Add optional parameter", "Add new module"],
      "compatibility": "BACKWARD_COMPATIBLE",
      "migration_required": false
    },
    "PATCH": {
      "description": "Backward-compatible bug fixes",
      "increment_when": "Bug fix without feature changes",
      "examples": ["Fix event validation bug", "Fix service initialization issue"],
      "compatibility": "BACKWARD_COMPATIBLE",
      "migration_required": false
    }
  },

  "artifact_versioning": {
    "modules": {
      "version_tracking": "SEMANTIC",
      "version_location": "ModuleManifest.json",
      "version_update_rule": "MAJOR for breaking changes, MINOR for features"
    },
    "events": {
      "version_tracking": "SEMANTIC",
      "version_location": "SchemaRegistry.json",
      "version_update_rule": "MAJOR if schema breaks compatibility, MINOR for additions"
    },
    "services": {
      "version_tracking": "SEMANTIC",
      "version_location": "Module manifest",
      "version_update_rule": "Follow module version"
    },
    "schemas": {
      "version_tracking": "SEMANTIC",
      "version_location": "SchemaRegistry.json",
      "version_update_rule": "MAJOR if breaks compatibility, MINOR for additions"
    }
  },

  "version_lifecycle": {
    "alpha": {
      "stage": "Development",
      "notation": "1.0.0-alpha",
      "stability": "UNSTABLE",
      "usage": "Internal testing only",
      "compatibility_guarantee": "NONE"
    },
    "beta": {
      "stage": "Feature complete",
      "notation": "1.0.0-beta",
      "stability": "MOSTLY_STABLE",
      "usage": "Limited external testing",
      "compatibility_guarantee": "PARTIAL"
    },
    "rc": {
      "stage": "Release candidate",
      "notation": "1.0.0-rc1",
      "stability": "STABLE",
      "usage": "Ready for production validation",
      "compatibility_guarantee": "MOSTLY_GUARANTEED"
    },
    "release": {
      "stage": "Production release",
      "notation": "1.0.0",
      "stability": "STABLE",
      "usage": "Production-ready",
      "compatibility_guarantee": "GUARANTEED"
    }
  },

  "version_dependencies": {
    "rule": "Modules must declare compatible versions of dependencies",
    "format": "dependency_id: version_constraint",
    "constraints": ["==", "^", "~", ">=", "<="],
    "example": "auth: ^1.0.0 means >= 1.0.0 and < 2.0.0"
  },

  "version_deprecation": {
    "lifecycle": {
      "active": "Current version, fully supported",
      "deprecated": "Still works, will be removed in next major",
      "sunset": "Completely removed, no longer available"
    },
    "notice_period": "2 releases before removal for MAJOR changes",
    "documentation_requirement": "Deprecated versions must have migration guide"
  },

  "version_release_process": {
    "step_1": "Increment version number according to semantic versioning",
    "step_2": "Update CHANGELOG with changes",
    "step_3": "Update all artifact version references",
    "step_4": "Create release tag in version control",
    "step_5": "Document breaking changes and migration guides",
    "step_6": "Update compatibility matrix",
    "step_7": "Release to production"
  },

  "current_versions": {
    "system_version": "1.0.0",
    "api_version": "1.0.0",
    "database_schema_version": "1.0.0",
    "event_schema_version": "1.0.0",
    "module_manifest_version": "1.0.0",
    "bootstrap_version": "1.0.0"
  },

  "governance": {
    "sealed": true,
    "immutable": true,
    "read_only": true,
    "versioning_policy_version": "1.0.0",
    "policy_approval_date": "2026-05-07",
    "next_review_date": "2026-06-07"
  }
}
