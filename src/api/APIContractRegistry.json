  "endpoints": [
    {
      "id": "auth:login",
      "module": "auth",
      "method": "POST",
      "path": "/api/v1/auth/login",
      "displayName": "User Login",
      "description": "Authentifier un utilisateur avec email/password",
      "request": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "refreshToken": { "type": "string" },
          "user": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "email": { "type": "string" },
              "username": { "type": "string" },
              "role": { "type": "string", "enum": ["user", "admin", "moderator"] }
            }
          }
        }
      },
      "permissions": ["public"],
      "eventsEmitted": ["auth:success", "auth:failure"],
      "statusCodes": {
        "200": "Login successful",
        "401": "Invalid credentials",
        "400": "Validation error"
      }
    },
    {
      "id": "auth:register",
      "module": "auth",
      "method": "POST",
      "path": "/api/v1/auth/register",
      "displayName": "User Registration",
      "description": "Créer un nouveau compte utilisateur",
      "request": {
        "type": "object",
        "required": ["email", "password", "username"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "username": { "type": "string", "minLength": 3, "maxLength": 50 }
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "user": { "type": "object" },
          "token": { "type": "string" }
        }
      },
      "permissions": ["public"],
      "eventsEmitted": ["user:created", "auth:success"],
      "statusCodes": { "201": "User created", "400": "Validation error", "409": "Email already exists" }
    },
    {
      "id": "auth:refresh",
      "module": "auth",
      "method": "POST",
      "path": "/api/v1/auth/refresh",
      "displayName": "Refresh Token",
      "description": "Obtenir un nouveau access token",
      "request": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": { "refreshToken": { "type": "string" } }
      },
      "response": {
        "type": "object",
        "properties": { "token": { "type": "string" } }
      },
      "permissions": ["authenticated"],
      "eventsEmitted": ["auth:token_refreshed"],
      "statusCodes": { "200": "Token refreshed", "401": "Invalid token" }
    },
