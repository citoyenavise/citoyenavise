# Configuration pour déploiement Docker (docker-compose up)
# Utiliser en développement avec docker-compose

# Server
NODE_ENV=development
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=citoyenavise_dev
DB_PORT=5432

# Redis
REDIS_PASSWORD=password
REDIS_PORT=6379

# JWT Secrets (IMPORTANT: Min 32 chars, DOIVENT ÊTRE DIFFÉRENTS!)
JWT_SECRET=dev_secret_key_min_32_chars_change_in_prod_abc123def456
JWT_REFRESH_SECRET=dev_refresh_secret_key_min_32_chars_abc123def456_DIFFERENT

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost

# Logging
LOG_LEVEL=debug

# Admin Panel (pgAdmin)
PGADMIN_EMAIL=admin@citoyenavise.local
PGADMIN_PASSWORD=admin

# Optional services
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
