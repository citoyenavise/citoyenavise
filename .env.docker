# Configuration pour déploiement Docker (docker-compose up)
# Copier en .env et adapter les secrets

# Server
NODE_ENV=production
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Database
DB_USER=postgres
DB_PASSWORD=change_me_generate_strong_password
DB_NAME=citoyenavise
DB_PORT=5432

# Redis
REDIS_PASSWORD=change_me_generate_strong_password
REDIS_PORT=6379

# JWT Secret (IMPORTANT: Générer une nouvelle clé!)
# openssl rand -base64 32
JWT_SECRET=change_me_generate_strong_32_char_secret_key_NOW

# URLs
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost

# Logging
LOG_LEVEL=info

# Admin Panel (pgAdmin)
PGADMIN_EMAIL=admin@citoyenavise.local
PGADMIN_PASSWORD=change_me

# Optional services
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
